# Python 缓存
__pycache__/
*.pyc
*.pyo

# 本地 Claude 配置/状态
.claude/

# 构建产物（发布用 GitHub Release 挂 zip，不进仓库）
dist/

# 测试用文件
efx_samples/

# 预设：__attributes__/ 与 __archetypes__/ 是随扩展下发的 curated 默认预设
# （入库保证构建可复现）；其余（用户运行期保存的 __entries__ 等）不入库。
presets/*
!presets/__attributes__/
!presets/__archetypes__/

# 开发/参考文档与测试笔记。
# 本地保留供开发与 Claude 读取；仅不进远程。
*.md
!README.md
docs/
refs/

# 统计分析结果
stats/

# 开发/构建/测试脚本：非插件本体内容，本地保留，不入库
tools/

# addon_updater 运行时暂存/备份目录（下载更新用，非源码）
efx_editor_updater/

# 运行期保存的语言偏好（i18n.save_lang 写出，非源码；正常应落在用户配置目录）
efx_editor_lang.txt
