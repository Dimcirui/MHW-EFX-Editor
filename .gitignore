# Python 缓存
__pycache__/
*.pyc
*.pyo

# 本地 Claude 配置/状态
.claude/

# 构建产物（发布用 GitHub Release 挂 zip，不进仓库）
dist/

# 提取的 MHW 游戏资产（版权，不上传；测试在本地跑）
efx_samples/

# 预设：__attributes__/ 是随扩展下发的默认属性预设（curated，入库保证构建可复现）；
# 其余（用户运行期保存的、__entries__ 等）不入库。
presets/*
!presets/__attributes__/

# 开发/参考文档与逆向笔记（插件运行不需要，私人维护，不上传）。
# 本地保留供开发与 Claude 读取；仅不进远程。
*.md
!README.md
docs/
refs/

# 统计分析结果（本地记录，不上传）
stats/

# 开发/构建/测试脚本：非插件本体内容，本地保留，不入库
tools/

# addon_updater 运行时暂存/备份目录（下载更新用，非源码）
efx_editor_updater/
